# Secrets and build noise that must never reach the image. .env is the
# important one: `COPY . .` would otherwise bake API_HASH, BOT_TOKEN and
# REDIS_PASSWORD into a layer.
.env
.env.*
**/*cookies*.txt*
**/.cache/
*.session
cache*.db

.git
.gitignore
.claude
.zed
.vscode
.idea

node_modules/
bin/
dist/
coverage/
cf-worker-test/

Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore
README.md
