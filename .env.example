# ── Telegram Bot API Credentials ───────────────────────────────────────────────
# ── Telegram Bot API Credentials ──────────────────────────────
# Legacy MTProto credentials. The bot talks to the HTTP Bot API directly, so
# API_ID / API_HASH are unused; they are accepted only for .env compatibility.
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# Generate BOT_TOKEN using @BotFather on Telegram.
# Optional: if it is empty the process still serves the HTTP API standalone.
BOT_TOKEN=1234567890:YOUR_BOT_TOKEN_HERE

# Support group and update channel usernames (without '@')
TG_GROUP=nub_coder_s
TG_CHANNEL=nub_coders

# Space-separated list of Telegram User IDs who have administrative privileges
# Replace with your own IDs — never commit real IDs.
ADMIN_IDS="000000000 000000000"

# Set to false to disable starting the Telegram bot (e.g. during testing)
START_BOT=true
ENABLE_BOT=true

# ── Redis Configuration ─────────────────────────────────────────────────────────
# Connection details for Redis caching & rate limiting
# Optional complete URL. Takes precedence over all discrete settings below;
# preserves TLS (rediss://), database number, and the default port 6379.
# REDIS_URL=rediss://default:password@redis.example:6379/0
REDIS_HOST=localhost
REDIS_PORT=15440
REDIS_USERNAME=default
REDIS_PASSWORD=

# Optional Upstash Redis for search service caching
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ── API Rate Limits ─────────────────────────────────────────────────────────────
# Default daily request counts allowed per user/admin token
DAILY_LIMIT=100000
ADMIN_LIMIT=100000
# Optional secret key for direct admin API access (Authorization: Bearer <ADMIN_API_KEY>)
# ADMIN_API_KEY=your_secret_admin_key_here

# ── Deployment Host & Public URL ──────────────────────────────────────────────
# API_HOST=api.nubcoders.com
# BASE_URL=https://api.nubcoders.com

# ── YouTube Data API (Optional) ─────────────────────────────────────────────────
# Comma-separated list of official YouTube Data API keys for search/metadata fast-path
# YOUTUBE_API_KEYS=AIzaSy...,AIzaSy...

# ── Webshare geo-bypass proxy pool (Optional) ──────────────────────────────────
# API token from the Webshare dashboard (Account → API). Required for fresh
# YouTube extraction: all Innertube bootstrap/player requests use Webshare.
# Media transfer prefers the server's direct connection when its probe passes.
# Without this key or a usable exit, extraction fails without a direct fallback.
WEBSHARE_API_KEY=
# Restrict extraction proxies to these ISO country codes (comma separated, empty = all)
WEBSHARE_PROXY_COUNTRIES=
# How often to re-fetch the proxy list from the Webshare API (seconds)
WEBSHARE_REFRESH_SEC=600

# Shared YouTube Data API search controls (all API replicas and configured keys).
# Each uncached attempt reserves 101 quota units; reset is midnight US Pacific.
# This allocation leaves quota for metadata. 0 disables uncached Data API searches.
YOUTUBE_SEARCH_DAILY_BUDGET=5000
YOUTUBE_SEARCH_REQUESTS_PER_MINUTE=10
YOUTUBE_SEARCH_MAX_CONCURRENCY=4
