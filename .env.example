# ── Telegram Bot API Credentials ───────────────────────────────────────────────
# ── Telegram Bot API Credentials ──────────────────────────────
# Legacy MTProto credentials. The bot talks to the HTTP Bot API directly, so
# API_ID / API_HASH are unused; they are accepted only for .env compatibility.
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# Generate BOT_TOKEN using @BotFather on Telegram.
# Optional: if it is empty the process still serves the HTTP API standalone.
BOT_TOKEN=1234567890:YOUR_BOT_TOKEN_HERE

# Support group and update channel usernames (without '@')
TG_GROUP=nub_coder_s
TG_CHANNEL=nub_coders

# Space-separated list of Telegram User IDs who have administrative privileges
# Replace with your own IDs — never commit real IDs.
ADMIN_IDS="000000000 000000000"

# Set to false to disable starting the Telegram bot (e.g. during testing)
START_BOT=true
ENABLE_BOT=true

# ── Redis Configuration ─────────────────────────────────────────────────────────
# Connection details for Redis caching & rate limiting
# Optional complete URL. Takes precedence over all discrete settings below;
# preserves TLS (rediss://), database number, and the default port 6379.
# REDIS_URL=rediss://default:password@redis.example:6379/0
REDIS_HOST=localhost
REDIS_PORT=15440
REDIS_USERNAME=default
REDIS_PASSWORD=

# Optional Upstash Redis for search service caching
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ── API Rate Limits ─────────────────────────────────────────────────────────────
# Default daily request counts allowed per user/admin token
DAILY_LIMIT=100000
ADMIN_LIMIT=100000
# Optional secret key for direct admin API access and script uploads (Authorization: Bearer <ADMIN_API_KEY>)
# ADMIN_API_KEY=your_secret_admin_key_here

# Optional MongoDB multi-cookie pool (dynamic pool with no limit, auto-rotation & failover)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=tstube
# MONGODB_COOKIES_COLLECTION=youtube_cookies
# COOKIE_SYNC_INTERVAL_SEC=300
# COOKIE_PROBE_INTERVAL_SEC=900
# COOKIE_PROBE_DELAY_MS=3000

# Raw text cookies (e.g. pasted directly in environment or container secret).
# Accepts HTTP header format ("SID=...; HSID=..."), Netscape multiline text, or base64.
# Takes precedence over COOKIES_FILE.
# COOKIES_TEXT="SID=...; HSID=...; SAPISID=..."
COOKIES_FILE=cookies.txt
COOKIES_BROWSER=firefox
COOKIES_BOOTSTRAP_URL=https://youtu.be/EHtxN9sORzI
COOKIES_REFRESH_HOURS=6
# Optional Docker read-only seed via docker-compose.cookies.yml. It is copied
# into the writable COOKIES_FILE at container startup, never baked into images.
# COOKIES_SOURCE_FILE=./cookies.txt

# ── Deployment Host & Public URL ──────────────────────────────────────────────
# API_HOST=api.nubcoders.com
# BASE_URL=https://api.nubcoders.com

# ── YouTube Data API (Optional) ─────────────────────────────────────────────────
# Comma-separated list of official YouTube Data API keys for search/metadata fast-path
# YOUTUBE_API_KEYS=AIzaSy...,AIzaSy...

# ── Process / Concurrency Tuning (Optional) ───────────────────────────────────
# YTDLP_MAX_PROCS=4

# ── Webshare geo-bypass proxy pool (Optional) ──────────────────────────────────
# API token from the Webshare dashboard (Account → API). When set, videos that
# fail every cookie in the pool (geo-blocks) are retried through a Webshare
# datacenter proxy and streamed through it as well. Leave empty to disable.
WEBSHARE_API_KEY=
# Restrict fallback proxies to these ISO country codes (comma separated, empty = all)
WEBSHARE_PROXY_COUNTRIES=
# How often to re-fetch the proxy list from the Webshare API (seconds)
WEBSHARE_REFRESH_SEC=600
