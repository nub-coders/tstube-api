# ==============================================================================
# TsTube API Configuration
# ==============================================================================

# ── HTTP Server & Deployment ──────────────────────────────────────────────────
# [Optional] Port the HTTP API listens on (default: 8000)
PORT=8000

# [Optional] Host interface to bind (default: 0.0.0.0)
HOST=0.0.0.0

# [Optional] Public hostname used for edge routing and link generation (default: api.nubcoders.com)
API_HOST=api.nubcoders.com

# [Optional] Public base URL prepended to streaming endpoints (default: https://${API_HOST})
BASE_URL=https://api.nubcoders.com


# ── Redis (Rate Limiting, Job Leases, & Caching) ───────────────────────────────
# [Optional] Complete Redis connection URL. Takes precedence over discrete settings below.
# Supports TLS (rediss://), database selection (/0), and authentication credentials.
# REDIS_URL=rediss://default:password@redis.example.com:6379/0

# [Optional] Discrete Redis host when REDIS_URL is not set (default: localhost)
REDIS_HOST=localhost

# [Optional] Discrete Redis port when REDIS_URL is not set (default: 15440)
REDIS_PORT=15440

# [Optional] Discrete Redis username (default: default)
REDIS_USERNAME=default

# [Optional] Discrete Redis password (leave empty if no password is required)
REDIS_PASSWORD=

# [Optional] Upstash Redis REST URL for external search result caching
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...


# ── Webshare Rotating Proxy Pool (YouTube Extraction) ─────────────────────────
# [Optional / Recommended] API token from Webshare dashboard (Account -> API).
# Required for fresh YouTube extraction by default. All Innertube player and bootstrap
# requests rotate through Webshare datacenter proxies to prevent IP rate-limiting.
WEBSHARE_API_KEY=

# [Optional] Filter proxies to specific ISO country codes (comma-separated, empty = all)
WEBSHARE_PROXY_COUNTRIES=

# [Optional] How often to re-fetch the proxy exit list from Webshare API in seconds (default: 600)
WEBSHARE_REFRESH_SEC=600

# [Optional] Fall back to server's direct connection when proxy pool is empty (default: false)
EXTRACTION_DIRECT_FALLBACK=false


# ── Telegram Bot ──────────────────────────────────────────────────────────────
# [Optional] Enable or disable the integrated Telegram bot worker (default: true)
START_BOT=true

# [Required for Bot] Telegram Bot token obtained from @BotFather.
# If left empty, the server safely runs the HTTP API standalone without starting the bot.
BOT_TOKEN=1234567890:YOUR_BOT_TOKEN_HERE

# [Optional] Space-separated list of numeric Telegram User IDs with administrative rights
ADMIN_IDS="000000000 000000000"

# [Optional] Public username for support group (without '@', default: nub_coder_s)
TG_GROUP=nub_coder_s

# [Optional] Public username for updates channel (without '@', default: nub_coders)
TG_CHANNEL=nub_coders

# [Optional] Legacy MTProto client credentials (unused by HTTP Bot API; kept for backward compatibility)
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627


# ── API Rate Limits & Security ────────────────────────────────────────────────
# [Optional] Default daily request quota per regular user token (default: 100000)
DAILY_LIMIT=100000

# [Optional] Default daily request quota per admin token (default: 100000)
ADMIN_LIMIT=100000

# [Optional] Static secret key for direct administrative API access (Authorization: Bearer <ADMIN_API_KEY>)
# ADMIN_API_KEY=your_secret_admin_key_here


# ── YouTube Data API v3 (Optional Fast-Path) ──────────────────────────────────
# [Optional] Comma-separated official Google/YouTube Data API v3 keys for search & metadata fast-path
# YOUTUBE_API_KEYS=AIzaSy...,AIzaSy...

# [Optional] Shared daily quota budget for uncached Data API searches across replicas (default: 5000)
# Set to 0 to disable uncached Data API searches (falls back to scraped search).
YOUTUBE_SEARCH_DAILY_BUDGET=5000

# [Optional] Maximum uncached Data API searches allowed per rolling minute (default: 10)
YOUTUBE_SEARCH_REQUESTS_PER_MINUTE=10

# [Optional] Maximum concurrent Data API search requests (default: 4)
YOUTUBE_SEARCH_MAX_CONCURRENCY=4
